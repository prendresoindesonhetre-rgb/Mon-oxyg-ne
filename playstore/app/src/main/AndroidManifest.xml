<?xml version="1.0" encoding="utf-8"?>
<!-- Mon Oxygène pour le Play Store : la version web v83 validée, embarquée dans l'appli.
     Aucune autorisation demandée : l'appli fonctionne sans internet et n'envoie rien. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:theme="@style/Theme.MonOxygene"
        android:label="@string/nom"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- configChanges : sur tablette ou écran pliable, tourner l'écran ne relance pas la séance en cours. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
