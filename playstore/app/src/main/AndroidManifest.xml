<?xml version="1.0" encoding="utf-8"?>
<!-- Mon Oxygène pour le Play Store : la version web, embarquée dans l'appli.
     Internet sert seulement aux codes cadeaux : les activer (une fois) et les revérifier de temps en temps.
     Les séances marchent sans internet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:theme="@style/Theme.MonOxygene"
        android:label="@string/nom"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true">
        <!-- configChanges : sur tablette ou écran pliable, tourner l'écran ne relance pas la séance en cours. -->
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true">
            <!-- Mon Oxygène se tient couché, tablettes comprises (choix de Yoann, 26 nov. 2026) : Android 16 ignore
                 d'office screenOrientation sur les grands écrans ; cette option lui demande de le respecter.
                 Là où le sens ne peut pas être imposé (écran partagé, Android 17+), la page a une version debout. -->
            <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
